{% extends 'base.html.twig' %}

{% block body %}
    <div class="p-4 mb-4 bg-primary text-white rounded-3">
        <div class="row align-items-center">
            <div class="col-md-7">
                <h1 class="display-6 fw-bold">ENI Covoiturage</h1>
                <p class="mb-0">Trouvez un trajet vers votre campus ou proposez vos places.</p>
            </div>
            <div class="col-md-5 text-md-end mt-3 mt-md-0">
                {% if app.user %}
                    <a href="{{ path('app_trajet_nouveau') }}" class="btn btn-light">Publier un trajet</a>
                {% else %}
                    <a href="{{ path('app_register') }}" class="btn btn-light">Créer mon compte @campus-eni.fr</a>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            {{ form_start(formRecherche) }}
            <div class="row g-3 align-items-end">
                <div class="col-md-3">{{ form_row(formRecherche.site) }}</div>
                <div class="col-md-3">{{ form_row(formRecherche.sens) }}</div>
                <div class="col-md-3">{{ form_row(formRecherche.date) }}</div>
                <div class="col-md-3">{{ form_row(formRecherche.ville) }}</div>
                <div class="col-12 text-end">
                    {{ form_row(formRecherche.submit, {'attr': {'class': 'btn-primary'}}) }}
                </div>
            </div>
            {{ form_end(formRecherche) }}
        </div>
    </div>

    <h2 class="mb-3">Trajets disponibles ({{ trajets|length }})</h2>

    {% if trajets is empty %}
        <div class="alert alert-info">
            Aucun trajet ne correspond à votre recherche. Publiez le premier !
        </div>
    {% else %}
        <div class="row">
            {% for trajet in trajets %}
                <div class="col-md-6 mb-3">
                    <div class="card h-100 {% if trajet.sens.value == 'vers_site' %}border-success-subtle{% else %}border-info-subtle{% endif %}">
                        <div class="card-body">
                            <div class="d-flex justify-content-between">
                                <h5 class="card-title mb-1">
                                    {{ trajet.villeDepart }} <span class="text-muted">&rarr;</span> {{ trajet.villeArrivee }}
                                </h5>
                                <span class="badge bg-primary">{{ trajet.sens.libelle }}</span>
                            </div>
                            <p class="text-muted mb-2">
                                {{ trajet.dateDepart|date('d/m/Y à H:i') }} &middot; {{ trajet.site.nom }}
                            </p>
                            <p class="mb-2">
                                <strong>{{ trajet.getNbPlacesRestantes }}</strong> place(s) restante(s)
                                &middot; {{ trajet.prix|number_format(2, ',', ' ') }} €
                            </p>
                            <a href="{{ path('app_trajet_show', {'id': trajet.id}) }}" class="btn btn-sm btn-outline-primary">Voir le trajet</a>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
