{% extends 'base.html.twig' %}

{% block body %}
    {# Hero d'accueil (inspiré de la page d'atterrissage ENI Covoiturage) #}
    <div class="p-5 mb-4 rounded-3 text-white"
         style="background: linear-gradient(rgba(13, 71, 161, .85), rgba(13, 71, 161, .85)), url('{{ asset('img/banner-ecologique_conviviale.jpg') }}') center/cover no-repeat;">
        <div class="col-lg-9">
            <h1 class="display-6 fw-bold">Bienvenue sur votre plateforme de covoiturage !</h1>
            <p class="lead mb-2">
                Vous êtes étudiants, salariés ou intervenants à ENI École Informatique ?
                Cette plateforme de covoiturage est spécialement conçue pour vous !
            </p>
            <p class="mb-3">
                Que vous vous rendiez vers l'un de nos campus, connectez-vous avec d'autres personnes
                de la communauté ENI et transformez vos trajets en moments d'échange et de convivialité.
            </p>
            {% if app.user %}
                <a href="{{ path('app_trajet_nouveau') }}" class="btn btn-light btn-lg">Publier un trajet</a>
            {% else %}
                <a href="{{ path('app_register') }}" class="btn btn-light btn-lg">Créer mon compte @campus-eni.fr</a>
            {% endif %}
        </div>
    </div>

    {# Avantages #}
    <h2 class="h4 mb-3">Pourquoi utiliser le covoiturage ENI ?</h2>
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="card h-100 text-center">
                <div class="card-body">
                    <div class="fs-2">💰</div>
                    <h3 class="h6 fw-bold mb-1">Économique</h3>
                    <p class="card-text text-muted small mb-0">Réduisez considérablement vos frais de transport</p>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card h-100 text-center">
                <div class="card-body">
                    <div class="fs-2">🌱</div>
                    <h3 class="h6 fw-bold mb-1">Écologique</h3>
                    <p class="card-text text-muted small mb-0">Diminuez votre empreinte carbone</p>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card h-100 text-center">
                <div class="card-body">
                    <div class="fs-2">👥</div>
                    <h3 class="h6 fw-bold mb-1">Convivial</h3>
                    <p class="card-text text-muted small mb-0">Créez des liens</p>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card h-100 text-center">
                <div class="card-body">
                    <div class="fs-2">🚗</div>
                    <h3 class="h6 fw-bold mb-1">Pratique</h3>
                    <p class="card-text text-muted small mb-0">Facilitez vos déplacements vers les campus</p>
                </div>
            </div>
        </div>
    </div>

    {# Nos campus #}
    <h2 class="h4 mb-3">Nos campus</h2>
    <div class="row g-3 mb-4">
        {% for c in campus %}
            <div class="col-md-4 campus-col">
                <div class="card h-100 shadow-sm">
                    <img src="{{ asset(c.image) }}" class="card-img-top" alt="{{ c.site.nom }}"
                         style="height: 140px; object-fit: cover;">
                    <div class="card-body">
                        <h3 class="h6 card-title text-uppercase fw-bold">{{ c.site.nom }}</h3>
                        <p class="card-text text-muted small mb-0">
                            {% if c.site.adresse %}
                                {{ c.site.adresse }}, {{ c.site.ville }} ({{ c.site.codePostal }})
                            {% else %}
                                Campus en ligne
                            {% endif %}
                        </p>
                    </div>
                    <div class="card-footer bg-transparent border-0 pt-0 d-flex gap-2">
                        <a href="{{ path('app_campus_show', {'id': c.site.id}) }}"
                           class="btn btn-outline-secondary flex-fill">Détails</a>
                        <a href="{{ path('app_home', {'trajet_search': {'site': c.site.id}}) }}"
                           class="btn btn-primary flex-fill">Covoiturer</a>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>

    {# Recherche de trajets #}
    <div class="card mb-4">
        <div class="card-body">
            {{ form_start(formRecherche) }}
            <div class="row g-3 align-items-end">
                <div class="col-md-3">{{ form_row(formRecherche.site) }}</div>
                <div class="col-md-3">{{ form_row(formRecherche.sens) }}</div>
                <div class="col-md-3">{{ form_row(formRecherche.date) }}</div>
                <div class="col-md-3">{{ form_row(formRecherche.ville) }}</div>
                <div class="col-12 text-end">
                    {{ form_row(formRecherche.submit, {'attr': {'class': 'btn-primary'}}) }}
                </div>
            </div>
            {{ form_end(formRecherche) }}
        </div>
    </div>

    <h2 class="h4 mb-3">Trajets disponibles ({{ trajets|length }})</h2>

    {% if trajets is empty %}
        <div class="alert alert-info">
            Aucun trajet ne correspond à votre recherche. Publiez le premier !
        </div>
    {% else %}
        <div class="row">
            {% for trajet in trajets %}
                {% include 'trajet/_card.html.twig' %}
            {% endfor %}
        </div>
    {% endif %}

    {# Carte interactive OpenStreetMap des trajets #}
    <h2 class="h4 mb-3">Carte des trajets</h2>
    <div class="card mb-4">
        <div class="card-body">
            <div class="row g-2 align-items-end mb-3">
                <div class="col-md-4">
                    <label for="filtre-campus-carte" class="form-label">Filtrer par campus</label>
                    <select id="filtre-campus-carte" class="form-select">
                        <option value="">Tous les campus</option>
                        {% for c in campus %}
                            <option value="{{ c.site.id }}">{{ c.site.nom }}</option>
                        {% endfor %}
                    </select>
                </div>
            </div>
            <div id="carte-trajets" class="rounded-3 border" style="height: 420px;"></div>
            <p class="text-muted small mt-2 mb-0">
                Carte © <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a> — géocodage Nominatim.
            </p>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        (function () {
            const TRAJETS = {{ trajetsCarteJson|raw }};
            const map = L.map('carte-trajets').setView([46.7, 2.5], 6);
            L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19,
                attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>'
            }).addTo(map);

            // Géocodage des villes via Nominatim (avec cache pour éviter les doublons).
            const cache = {};
            async function geocode(ville) {
                if (cache[ville] !== undefined) { return cache[ville]; }
                try {
                    const res = await fetch('https://nominatim.openstreetmap.org/search?format=json&limit=1&q='
                        + encodeURIComponent(ville + ', France'));
                    const data = await res.json();
                    cache[ville] = data.length ? [parseFloat(data[0].lat), parseFloat(data[0].lon)] : null;
                } catch (e) {
                    cache[ville] = null;
                }
                return cache[ville];
            }

            let couches = [];

            function popup(t, point) {
                return t.villeDepart + ' &rarr; ' + t.villeArrivee + '<br>'
                    + t.dateDepart + ' &middot; ' + t.sens + '<br>'
                    + '<strong>' + t.places + '</strong> place(s) &middot; ' + t.prix + ' &euro;<br>'
                    + t.siteNom + '<br><a href="' + t.url + '">Voir le trajet</a>';
            }

            async function afficher() {
                const filtre = document.getElementById('filtre-campus-carte').value;
                for (const c of couches) { map.removeLayer(c.layer); }
                couches = [];

                await Promise.all(TRAJETS.map(async (t) => {
                    t._depart = await geocode(t.villeDepart);
                    t._arrivee = await geocode(t.villeArrivee);
                }));

                const points = [];
                for (const t of TRAJETS) {
                    if (filtre && String(t.siteId) !== filtre) { continue; }
                    if (!t._depart || !t._arrivee) { continue; }
                    const layer = L.layerGroup();
                    L.polyline([t._depart, t._arrivee], {color: '#0d6efd', weight: 4, dashArray: '6 6'})
                        .bindPopup(popup(t)).addTo(layer);
                    L.circleMarker(t._depart, {radius: 6, color: '#198754', fillColor: '#198754', fillOpacity: 0.9})
                        .bindPopup(popup(t)).addTo(layer);
                    L.circleMarker(t._arrivee, {radius: 6, color: '#dc3545', fillColor: '#dc3545', fillOpacity: 0.9})
                        .bindPopup(popup(t)).addTo(layer);
                    layer.addTo(map);
                    couches.push({siteId: t.siteId, layer: layer});
                    points.push(t._depart, t._arrivee);
                }

                if (points.length) {
                    map.fitBounds(L.latLngBounds(points).pad(0.2));
                }
            }

            document.getElementById('filtre-campus-carte').addEventListener('change', afficher);
            afficher();
        })();
    </script>
{% endblock %}
