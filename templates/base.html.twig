<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}ENI Covoiturage{% endblock %}</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    </head>
    <body class="bg-body-tertiary">
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary mb-4">
            <div class="container">
                <a class="navbar-brand" href="{{ path('app_home') }}">ENI Covoiturage</a>
                <div class="navbar-nav ms-auto align-items-lg-center">
                    {% if app.user %}
                        {% if is_granted('ROLE_ADMIN') %}
                            <a class="nav-link" href="{{ path('app_admin_dashboard') }}">Admin</a>
                        {% endif %}
                        <a class="nav-link" href="{{ path('app_trajet_nouveau') }}">Publier un trajet</a>
                        <a class="nav-link" href="{{ path('app_mes_trajets') }}">Mes trajets</a>
                        <a class="nav-link" href="{{ path('app_vehicule_index') }}">Mes véhicules</a>
                        <a class="navbar-text nav-link me-3 ms-2 text-white" href="{{ path('app_profil', {'id': app.user.id}) }}">{{ app.user.prenom }} {{ app.user.nom }}</a>
                        <a class="nav-link" href="{{ logout_url() }}">Déconnexion</a>
                    {% else %}
                        <a class="nav-link" href="{{ path('app_login') }}">Connexion</a>
                        <a class="nav-link" href="{{ path('app_register') }}">Inscription</a>
                    {% endif %}
                </div>
            </div>
        </nav>
        <main class="container">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label }}" role="alert">{{ message }}</div>
                {% endfor %}
            {% endfor %}
            {% block body %}{% endblock %}
        </main>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    </body>
</html>
