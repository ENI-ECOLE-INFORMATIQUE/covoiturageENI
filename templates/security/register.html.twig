{% extends 'base.html.twig' %}

{% block title %}Inscription — ENI Covoiturage{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h1 class="h3 mb-2">Créer un compte</h1>
                    <p class="text-muted">
                        Réservé aux adresses @campus-eni.fr — étudiants, formateurs et personnel de l'ENI.
                    </p>

                    {{ form_start(registrationForm) }}
                        {{ form_widget(registrationForm) }}
                    {{ form_end(registrationForm) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
