<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/12.5/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         cacheDirectory="var/cache/phpunit"
         executionOrder="depends,defects"
         failOnRisky="true"
         failOnWarning="true"
         colors="true">
    <php>
        <ini name="error_reporting" value="-1"/>
        <env name="KERNEL_CLASS" value="App\Kernel" force="true"/>
        <env name="APP_ENV" value="test" force="true"/>
        <env name="SHELL_VERBOSITY" value="-1" force="true"/>
        <env name="SYMFONY_DEPRECATIONS_HELPER" value="weak" force="true"/>
        <env name="DATABASE_URL" value="sqlite:///%kernel.project_dir%/var/cache/test.db" force="true"/>
        <env name="MAILER_DSN" value="null://null" force="true"/>
    </php>
    <testsuites>
        <testsuite name="Fonctionnel">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
